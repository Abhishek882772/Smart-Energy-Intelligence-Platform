# Local Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Large compressed archives
*.zip
*.7z
*.tar.gz

# Raw research data and binary processed shards
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep
!data/processed/REFIT/
data/processed/REFIT/*
!data/processed/REFIT/dataset_manifest.json

# Model checkpoints and large weight binaries
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.h5
*.keras

# Experiment outputs
results/experiments/*
!results/.gitkeep
!results/*.md
!results/*.csv
!results/figures/*
